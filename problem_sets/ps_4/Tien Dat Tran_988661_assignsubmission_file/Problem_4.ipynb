        "import patient_data\n",
        "\n",
        "patients = patient_data.get_patients()\n",
        "\n",
        "print(\"Patients Matching Screening Rule\")\n",
        "\n",
        "for patient in patients:\n",
        "    if patient_data.screening_rule(patient):\n",
        "        patient_data.display_patient(patient)\n",
        "        print(\"\")"
